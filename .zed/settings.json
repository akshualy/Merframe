{
    "lsp": {
        "biome": {
            "settings": {
                "config_path": "app/biome.json",
                "require_config_file": true,
            },
        },
        "rust-analyzer": {
            "initialization_options": {
                "rustfmt": {
                    "extraArgs": ["+nightly"],
                },
            },
        },
    },
    "languages": {
        "JavaScript": {
            "formatter": { "language_server": { "name": "biome" } },
        },
        "TypeScript": {
            "formatter": { "language_server": { "name": "biome" } },
        },
        "TSX": {
            "formatter": { "language_server": { "name": "biome" } },
        },
        "JSON": {
            "formatter": { "language_server": { "name": "biome" } },
        },
        "CSS": {
            "formatter": { "language_server": { "name": "biome" } },
        },
        "TOML": {
            "formatter": "none",
        },
    },
    "tab_size": 4,
}
