{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities the Merframe main window needs: Core defaults, opening a link in the desktop browser, checking for and installing updates.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://wiki.warframe.com" },
        { "url": "https://wiki.warframe.com/*" },
        { "url": "https://warframe.market" },
        { "url": "https://warframe.market/*" },
        { "url": "https://yareli.net" },
        { "url": "https://yareli.net/*" },
        { "url": "https://github.com" },
        { "url": "https://github.com/*" },
        { "url": "https://alecaframe.com" },
        { "url": "https://alecaframe.com/*" },
        { "url": "https://browse.wf" },
        { "url": "https://browse.wf/*" }
      ]
    },
    "updater:default",
    "process:allow-restart"
  ]
}
